# Which translation service to use: mymemory (default, free, no key) | azure | libretranslate
TRANSLATOR=mymemory

# MyMemory: optional email, gives a higher daily free limit
MYMEMORY_EMAIL=

# Azure Translator (use later, when you have a key)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# LibreTranslate (self-hosted)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# Free-tier protection: max characters per visitor (IP) per day
DAILY_CHAR_LIMIT=20000
